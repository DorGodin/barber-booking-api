# Copy to .env for local development: cp .env.example .env
# Every value here is a development placeholder. Never reuse one anywhere real.

# Signs every login token. At least 32 characters. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-signing-key-not-for-any-real-use

# The first start seeds the shop with these passwords: the owner; the four
# barbers (barber, barber.yossi, barber.moran, barber.ron) share the barber one;
# the two customers (customer = Dana, yael = Yael) share the customer one - sign
# in as each in two windows to see two customers go for the same time.
SEED_OWNER_PASSWORD=dev-owner-password
SEED_BARBER_PASSWORD=dev-barber-password
SEED_CUSTOMER_PASSWORD=dev-customer-password

DATABASE_URL=sqlite:///./barber.db
SHOP_TZ=Asia/Jerusalem
BOOKING_WINDOW_DAYS=60
CANCEL_CUTOFF_HOURS=24
# Failed sign-ins before a 15 minute refusal: per account from one address, and
# per address for any accounts.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCK_MINUTES=15
