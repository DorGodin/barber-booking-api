# Copy to .env for local development: cp .env.example .env
# Every value here is a development placeholder. Never reuse one anywhere real.

# Signs every login token. At least 32 characters. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-signing-key-not-for-any-real-use

# The first start seeds the shop with these passwords: the owner; the four
# barbers (barber, barber.yossi, barber.moran, barber.ron) share the barber one;
# the two customers (customer = Dana, yael = Yael) share the customer one - sign
# in as each in two windows to see two customers go for the same time.
SEED_OWNER_PASSWORD=dev-owner-password
SEED_BARBER_PASSWORD=dev-barber-password
SEED_CUSTOMER_PASSWORD=dev-customer-password

DATABASE_URL=sqlite:///./barber.db
SHOP_TZ=Asia/Jerusalem
SHOP_BRAND=TomGoldin
# The shop's header on its page. Every one may be left empty: an empty link has
# no button. Links must be https://; phones are Israeli numbers. A bad value
# stops the server at startup, with its name. The pictures are files in
# MEDIA_DIR (empty: a media folder next to the database) - the shop's own.
# A value with spaces - the address, a tagline other than HAIR DESIGN - is set in
# the server's environment, not here: make sources this file as shell and Docker
# reads it as is, and no quoting suits both.
SHOP_SINCE=1991
SHOP_WHATSAPP=
SHOP_PHONE=
SHOP_INSTAGRAM_URL=
SHOP_TIKTOK_URL=
SHOP_WAZE_URL=
MEDIA_DIR=
SHOP_COVER_IMAGE=
SHOP_PROFILE_IMAGE=

# Sign-in codes by SMS. SMS_URL is the provider's address; "console" prints the
# message to the server's output instead - development only. Until the shop is
# live no paid provider is used: the outside test suites run a fake one.
SMS_URL=console
# SMS_TOKEN, the provider's key, is set in the server's own environment - never in a file.
OTP_TTL_SECONDS=300
OTP_ATTEMPTS=3
OTP_RESEND_SECONDS=60
OTP_PER_PHONE_PER_HOUR=5
OTP_PER_ADDRESS_PER_HOUR=20
BOOKING_WINDOW_DAYS=60
CANCEL_CUTOFF_HOURS=24
MOVE_CUTOFF_HOURS=12
# Failed sign-ins before a 15 minute refusal: per account from one address, and
# per address for any accounts.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCK_MINUTES=15
# The accessibility statement at /accessibility. Israeli law asks for a real
# contact and a description of the premises: fill these in before going live.
# Left empty, the statement says "(לדוגמה)" - an example, not a commitment.
ACCESSIBILITY_CONTACT_NAME=
ACCESSIBILITY_CONTACT_PHONE=
ACCESSIBILITY_CONTACT_EMAIL=
ACCESSIBILITY_PREMISES=
ACCESSIBILITY_UPDATED=
# The privacy policy at /privacy: who a customer writes to about their data.
# Example values until set. Have the text read before the shop goes live.
PRIVACY_CONTACT_PHONE=
PRIVACY_CONTACT_EMAIL=
PRIVACY_UPDATED=
# How many bookings ahead one customer may hold, and how many accounts one
# address may make in a window.
MAX_FUTURE_BOOKINGS=2
SIGNUPS_PER_ADDRESS=5
SIGNUP_WINDOW_MINUTES=60

# Backups: `make backup`, and one is taken by itself before a migration changes
# the database. Empty BACKUP_DIR = a backups/ folder next to the database.
BACKUP_DIR=
BACKUPS_KEPT=10
